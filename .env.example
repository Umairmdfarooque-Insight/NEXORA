APP_NAME=Nexora
UI_APP_NAME=Rayfin
ENVIRONMENT=development
LLM_PROVIDER=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Secrets (T-705): with KEY_VAULT_URL set, the model key (secret azure-openai-api-key) and the API client
# secret (entra-api-client-secret) are read from Azure Key Vault and these two stay empty here.
KEY_VAULT_URL=
AZURE_OPENAI_API_KEY=

FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=
FABRIC_LAKEHOUSE_ID=
FABRIC_LAKEHOUSE_NAME=
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
FABRIC_SANDBOX_WORKSPACE_ID=
SANDBOX_WORKSPACE_ID=

RUN_STORE=file
FABRIC_CONTROL_DB_SERVER=
FABRIC_CONTROL_DB_NAME=

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_CLIENT_SECRET=

# Telemetry (T-704): console | azuremonitor. Empty means no export.
OTEL_EXPORTER=
APPLICATIONINSIGHTS_CONNECTION_STRING=
